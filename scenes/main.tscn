[node name="description" type="RichTextLabel" parent="ui/about" unique_id=1727026403]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_left = 6.0
offset_top = 22.0
offset_right = -6.0
offset_bottom = 100.0
grow_horizontal = 2
theme_override_colors/default_color = Color(0.62352943, 0.7019608, 0.8, 1)
text = "PRESSURE PANIC! was created for the second Oink Jam. There were two themes for this jam, and I picked the themem of Under Pressure. This game surrounds a simple loop where you must collect gold, explore a cave, and survive the dangerous inhabitants before your oxygen runs out!"

[node name="credits" type="RichTextLabel" parent="ui/about" unique_id=1218449915]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_left = 6.0
offset_top = 96.0
offset_right = -6.0
offset_bottom = 178.0
grow_horizontal = 2
theme_override_colors/default_color = Color(0.62352943, 0.7019608, 0.8, 1)
text = "All art assets, code, and design was done by me, KingToot. Sound Effects were gathered from FilmCows Royalty Free Library and Atelier Magicae, with the music coming from Cleyton Kauffmans Exploration Theme from OpenGameArt."

